# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. When deploying to Netlify,
# set these same variables in Site settings → Environment variables.
#
# NOTE: Only variables prefixed with VITE_ are exposed to the frontend bundle.
# Everything else is server-side only (Netlify Functions) and must NEVER be
# prefixed with VITE_.
# ---------------------------------------------------------------------------

# ---- Frontend (safe to expose) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
# Base URL for calling Netlify functions locally the default works with `netlify dev`.
VITE_FUNCTIONS_BASE=/.netlify/functions

# ---- Supabase (server-side) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Service-role key bypasses RLS. Server-side ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Microsoft Azure AD / Graph (server-side) ----
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT=common
# Must exactly match the redirect URI registered in Azure AD.
MICROSOFT_REDIRECT_URI=http://localhost:8888/.netlify/functions/auth
# Space-separated Graph scopes.
MICROSOFT_SCOPES=openid profile email offline_access User.Read Tasks.ReadWrite Calendars.Read

# ---- App ----
# Where to send the user back after auth completes.
APP_BASE_URL=http://localhost:8888
# 32-byte (64 hex chars) key used to encrypt refresh tokens at rest (AES-256-GCM).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
