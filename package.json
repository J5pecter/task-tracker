{
  "name": "task-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ClickUp-inspired task manager with Microsoft Outlook (Graph) integration, Supabase, and Netlify Functions.",
  "scripts": {
    "dev": "netlify dev",
    "dev:vite": "vite",
